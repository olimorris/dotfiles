{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1"
  },
  "permissions": {
    "deny": []
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CODECOMPANION_HOOK\" ] || \"$CODECOMPANION_HOOK\" approval_requested"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CODECOMPANION_HOOK\" ] || \"$CODECOMPANION_HOOK\" approval_requested"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CODECOMPANION_HOOK\" ] || \"$CODECOMPANION_HOOK\" approval_finished"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/Users/Oli/.dotfiles/bin/rex-name-session --hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/Oli/.local/share/rex-agent-resume/bin/rex-agent-resume-hook claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gh-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "chrome-devtools-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "lavish-axi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CODECOMPANION_HOOK\" ] || \"$CODECOMPANION_HOOK\" done"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CODECOMPANION_HOOK\" ] || \"$CODECOMPANION_HOOK\" submitted"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true,
    "devrel-skills@n8n-devrel": true,
    "lua-lsp@claude-plugins-official": true,
    "n8n-skills@n8n-io": true,
    "postman@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "cc-plugin-telemetry@builtin": false,
    "telegram@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "n8n-devrel": {
      "source": {
        "source": "github",
        "repo": "n8n-io/devrel-skills"
      }
    },
    "n8n-io": {
      "source": {
        "source": "github",
        "repo": "n8n-io/skills"
      },
      "autoUpdate": true
    }
  },
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "pluginConfigs": {
    "n8n-skills@n8n-io": {
      "options": {
        "n8n_url": "https://tdr.app.n8n.cloud"
      }
    }
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '(.context_window.total_input_tokens // 0) as $t | (if $t >= 1000 then \"\\(($t / 100 | floor) / 10)k\" else \"\\($t)\" end) as $n | \"\\u001b[1;38;2;245;195;68m\\($n)\\u001b[0m (\\(.context_window.used_percentage // 0 | round)%) · \\(.model.display_name)\\(if .effort.level then \" (\\(.effort.level))\" else \"\" end)\"'"
  },
  "theme": "auto",
  "agentPushNotifEnabled": true
}
