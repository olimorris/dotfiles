# Ignore everything except directories
*
!*/

################################### WHITELIST ##################################

!favicon.svg
!PERSONAL.md

# Config
!.config/bash/**/*
!.config/composer/composer.json
!.config/efm-langserver/*
!.config/env/.env.example
!.config/fish/**/*
!.config/git/**/*
!.config/ghostty/**/*
!.config/hammerspoon/**/*
!.config/herdr/config.toml
!.config/herdr-app/keys.json
!.config/herdr-app/settings.json
!.config/herdr-app/programs.json
!.config/herdr-app/layouts/herdr-t3.*
!.config/herdr-app/layouts/workspace.json
!.config/herdr-app/my-icons/*
!.config/herdr-app/themes/onedarkpro-*.json
!.config/herdr-app/mods/t3-*/**/*
!.config/herdr-app/mods/pomodoro/**/*
!.config/herdr-app/mods/worktrunk/**/*
!.config/lazygit/**/*
!.config/mackup/**/*
!.config/mise/**/*
!.config/nix/**/*
!.config/nvim/**/*
!.config/opencode/**/*
!.config/pomodoro-cli/**/*
!.config/rclone/base_filter.txt
!.config/rclone/code_filter.txt
!.config/rclone/git_filter.txt
!.config/rclone/dotfiles_filter.txt
!.config/rex/init.lua
!.config/rex/session-label.lua
!.config/rex/zoxide-picker.sh
!.config/snippets/**/*
!.config/worktrunk/config.toml
!.config/zsh/**/*

# Dotbot
!dotbot.conf.yaml
!dotbot_uninstall

# Espanso
!.config/espanso/config/default.yml
!.config/espanso/match/coding.yml
!.config/espanso/match/math.yml
!.config/espanso/match/others.yml
!.config/espanso/match/words.yml

# Git
!.github/**/*
!.gitignore
!.gitignore_global
!.gitmodules

# Other dirs
!bin/**/*
!commands/**/*
!tasks/**/*
!tests/**/*

# Other files
!.tool-versions
!Rakefile
!README.md
!stylua.toml

################################### BLACKLIST ##################################

# Config
.config/herdr/plugins/*
.config/herdr-app/mods/**/gpui-kit.d.ts
.config/herdr-app/mods/win98/README.md
.config/rex/rex-worktrunk
.config/rex/rex-sessionizer
.config/hammerspoon/Spoons/*
.config/ghostty/themes

# Fish
.config/fish/fish_variables
.config/fish/fish_history

# Others
.DS_Store
/backup
.repro
misc/mackup

