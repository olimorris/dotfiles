#!/usr/bin/env bash
set -euo pipefail

state_file="$HOME/.codecompanion-worktree-state"
worktrees=(main feature-a feature-b)

current=$(cat "$state_file" 2>/dev/null || echo "main")

next_index=0
for i in "${!worktrees[@]}"; do
  if [[ "${worktrees[$i]}" == "$current" ]]; then
    next_index=$(((i + 1) % ${#worktrees[@]}))
    break
  fi
done

next="${worktrees[$next_index]}"
echo "$next" >"$state_file"
echo "$next"
