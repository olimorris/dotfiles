#!/usr/bin/env bash
set -euo pipefail

# Usage: rex-name-session <task>   rename this Rex session to "<repo>/<worktree>: <task>"
#        rex-name-session --sync   point the session at the current repo, keeping its task if the repo hasn't changed
#        rex-name-session --hook   print the naming instruction for an agent's SessionStart hook

[[ -n ${REX_BLOCK:-}${REX_SESSION:-} ]] || exit 0

if [[ ${1:-} == --hook ]]; then
    cat <<'EOF'
Name the Rex session as part of handling the first request that identifies the
work. Run `rex-name-session <label>` without waiting for the user to ask, and
never `rex session rename`. Use two to four lowercase words joined by hyphens,
such as `fix-login-redirect`. Name the task only: the command puts the repo and
worktree in front of it. Keep the existing label if it already describes the
same work.
EOF
    exit 0
fi

repo_prefix() {
    local dir folder origin repo
    dir=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
    folder=$(basename "$dir")
    origin=$(git -C "$dir" remote get-url origin 2>/dev/null || true)
    repo=${origin##*[/:]}
    repo=${repo%.git}

    # ~/.dotfiles and ~/Code/Swift/Strata are the main checkouts of "dotfiles" and "strata", not worktrees
    if [[ -z $repo ]]; then
        echo "$folder"
    elif [[ $(tr '[:upper:]' '[:lower:]' <<<"${folder#.}") == $(tr '[:upper:]' '[:lower:]' <<<"$repo") ]]; then
        echo "$repo"
    else
        echo "$repo/$folder"
    fi
}

if [[ ${1:-} == --sync ]]; then
    prefix=$(repo_prefix) || exit 0
    label=$(rex session inspect | sed -n 's/^label: //p')
    [[ $label == "$prefix" || $label == "$prefix: "* ]] && exit 0
    rex session rename "$prefix"
    exit 0
fi

task=${1:?usage: rex-name-session <task>}
prefix=$(repo_prefix || basename "$PWD")
rex session rename "$prefix: $task"
